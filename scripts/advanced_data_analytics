-- ============================================================
-- Advanced Data Analytics
-- ============================================================
-- Who creates value → what creates that value →
-- where that value comes from → how efficiently we deliver it →
-- how customers respond → what the business should prioritize.

-- ============================================================
-- Customer Segmentation
-- ============================================================
-- Business Question:
-- Which types of customers create the most value for the marketplace?
--
-- This view creates one record per unique customer and summarizes
-- their purchasing behavior, revenue contribution, and activity.
-- The customer_unique_id is used because a single real customer
-- can have multiple customer_id records across different orders.

IF OBJECT_ID('gold.vw_customer_report', 'V') IS NOT NULL
    DROP VIEW gold.vw_customer_report;
GO
CREATE VIEW gold.vw_customer_report AS
SELECT 
    dc.customer_unique_id AS customer,
    SUM(fo.order_item_payment) AS total_revenue, -- Monetary metrics
    SUM(fo.order_item_payment) / COUNT(DISTINCT fo.order_id) AS average_order_value,
    COUNT(DISTINCT fo.order_id) AS total_orders, -- Frequency metrics
    -- Customer timeline
    MIN(fo.purchase_date) AS first_order_date,
    MAX(fo.purchase_date) AS last_order_date,
    DATEDIFF(
        DAY,
        MIN(fo.purchase_date),
        MAX(fo.purchase_date)
    ) AS customer_lifespan_days,
    DATEDIFF(
        DAY,
        MAX(fo.purchase_date),
        GETDATE()
    ) AS customer_recency_days, -- Recency
        -- Monetary scoring:
        -- NTILE(5) divides customers into five groups based on revenue.
        -- The highest-revenue 20% receive a score of 5.
        NTILE(5) OVER (
            ORDER BY SUM(fo.order_item_payment)
        ) AS monetary_score,
        -- Recency scoring:
        -- More recent customers receive a higher score.
        NTILE(5) OVER (
            ORDER BY DATEDIFF(
        DAY,
        MAX(fo.purchase_date),
        GETDATE()) DESC
        ) AS recency_score
FROM gold.fact_orders AS fo
LEFT JOIN gold.dim_customers AS dc
ON dc.customer_key = fo.customer_key
GROUP BY 
    dc.customer_unique_id;
GO
-- ============================================================
SELECT 
    customer,
    CASE 
    WHEN total_orders = 1 THEN 'ONE-TIME'
    WHEN total_orders IN (2,3) THEN 'OCCASIONAL'
    ELSE 'REGULAR' 
    END AS customer_purchase_behavior, -- Frequency/ Purchase behavior of the customer
    CASE
        WHEN monetary_score = 5 THEN 'HIGH-VALUE' 
        ELSE 'LOW-VALUE'
    END AS monetary_value, -- Monetary value
    CASE
        WHEN recency_score > 4 THEN 'ACTIVE'
        WHEN recency_score = 3 THEN 'MODERATELY ACTIVE'
        ELSE 'INACTIVE'
    END AS customer_recency
FROM [gold].[vw_customer_report]

