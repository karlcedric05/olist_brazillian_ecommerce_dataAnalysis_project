-- ============================================================
-- Advanced Data Analytics
-- Customer Segmentation
-- Formatted nicely for maximum readability
-- ============================================================
-- Objective:
-- Identify meaningful customer groups based on purchasing
-- frequency and monetary value, then measure how much each
-- segment contributes to the customer base and total revenue.

-- The analysis uses customer_unique_id because one real customer
-- may have multiple customer_id records across different orders.
-- ============================================================

-- ============================================================
-- Building a Customer Report
-- ============================================================
-- Creates one record per unique customer and calculates the
-- key metrics needed for segmentation:
--
-- Monetary   → total revenue generated by the customer
-- Frequency  → number of orders placed
-- Recency    → days since the customer's most recent order in relation to the date scope of the data
-- Lifespan   → days between the customer's first and last order
--
-- NTILE(5) is used to rank customers into five groups. The
-- highest-revenue customers receive a monetary score of 5,
-- while the most recently active customers receive a recency
-- score of 5.
-- ============================================================

IF OBJECT_ID('gold.vw_customer_report', 'V') IS NOT NULL
    DROP VIEW gold.vw_customer_report;
GO

CREATE VIEW gold.vw_customer_report AS

SELECT
    dc.customer_unique_id AS customer,

    SUM(fo.order_item_payment) AS total_revenue, -- Total revenue generated by the customer

    SUM(fo.order_item_payment)
        / COUNT(DISTINCT fo.order_id) AS average_order_value, -- Average revenue per order

    COUNT(DISTINCT fo.order_id) AS total_orders, -- Number of orders placed

    MIN(fo.purchase_date) AS first_order_date,
    MAX(fo.purchase_date) AS last_order_date,

    DATEDIFF(
        DAY,
        MIN(fo.purchase_date),
        MAX(fo.purchase_date)
    ) AS customer_lifespan_days, -- Length of observed customer relationship

    DATEDIFF(
        DAY,
        MAX(fo.purchase_date),
        '2018-10-18' -- The day after the day the last order occured
    ) AS customer_recency_days, -- Days since the customer's most recent order

    -- Monetary scoring:
    -- Customers are divided into five groups based on revenue.
    -- The highest-revenue 20% receive a score of 5.
    NTILE(5) OVER (
        ORDER BY SUM(fo.order_item_payment)
    ) AS monetary_score,

    -- Recency scoring:
    -- More recent customers receive a higher score.
    NTILE(5) OVER (
        ORDER BY DATEDIFF(
            DAY,
            MAX(fo.purchase_date),
            '2018-10-18' -- The day after the day the last order occured
        ) DESC
    ) AS recency_score

FROM gold.fact_orders AS fo
LEFT JOIN gold.dim_customers AS dc
ON dc.customer_key = fo.customer_key
GROUP BY dc.customer_unique_id
GO

-- ============================================================
-- Customer Segmentation
-- ============================================================
-- Customers are first classified by purchase frequency,
-- monetary value, and recency. These characteristics are then
-- combined to create more meaningful business-oriented
-- customer segments.
-- ============================================================

WITH cte_customer_segmentation_report AS (

    SELECT
        customer,

        CASE
            WHEN total_orders = 1 THEN 'ONE-TIME'
            WHEN total_orders IN (2,3) THEN 'OCCASIONAL'
            ELSE 'REGULAR'
        END AS customer_purchase_behavior, -- Purchase frequency

        CASE
            WHEN monetary_score = 5 THEN 'HIGH-VALUE'
            ELSE 'LOW-VALUE'
        END AS monetary_value, -- Relative revenue contribution

        CASE
            WHEN recency_score >= 4 THEN 'ACTIVE'
            WHEN recency_score = 3 THEN 'MODERATELY ACTIVE'
            ELSE 'INACTIVE'
        END AS customer_recency, -- Recent purchasing activity

        monetary_score,
        recency_score,
        total_orders,
        total_revenue,
        average_order_value,
        customer_recency_days

    FROM gold.vw_customer_report
),

cte_advanced_customer_segment AS (

    SELECT
        customer,
        total_revenue,
        average_order_value,

        -- Combines purchase behavior and monetary value
        -- to create actionable customer segments.
        CASE
            WHEN customer_purchase_behavior = 'ONE-TIME'
                 AND monetary_value = 'LOW-VALUE'
                THEN 'Low-Engagement Customer'

            WHEN customer_purchase_behavior = 'ONE-TIME'
                 AND monetary_value = 'HIGH-VALUE'
                THEN 'High-Value One-Time Customer'

            WHEN customer_purchase_behavior = 'OCCASIONAL'
                 AND monetary_value = 'LOW-VALUE'
                THEN 'Developing Customer'

            WHEN customer_purchase_behavior = 'OCCASIONAL'
                 AND monetary_value = 'HIGH-VALUE'
                THEN 'Valuable but Not Yet Loyal'

            WHEN customer_purchase_behavior = 'REGULAR'
                 AND monetary_value = 'LOW-VALUE'
                THEN 'Loyal but Low-Spending'

            WHEN customer_purchase_behavior = 'REGULAR'
                 AND monetary_value = 'HIGH-VALUE'
                THEN 'Core High-Value Customer'

        END AS customer_segment
    FROM cte_customer_segmentation_report
)

-- ============================================================
-- Segment Performance
-- ============================================================
-- Measures the size and financial contribution of each
-- customer segment to identify which groups create the most
-- value for the marketplace.
-- ============================================================

SELECT
    customer_segment,
    COUNT(*) AS customer_count,
    SUM(total_revenue) AS total_revenue,
    AVG(total_revenue) AS avg_customer_revenue,
    AVG(average_order_value) AS avg_order_value,
    -- Percentage of the total customer base represented
    -- by each segment.
    COUNT(*) * 100.0
        / SUM(COUNT(*)) OVER()
        AS customer_contribution_pct,
    -- Percentage of total revenue generated by each segment.
    SUM(total_revenue) * 100.0
        / SUM(SUM(total_revenue)) OVER()
        AS revenue_contribution_pct
FROM cte_advanced_customer_segment
GROUP BY customer_segment
ORDER BY total_revenue DESC;
