-- ============================================================
-- Product Report
-- ============================================================
-- This report evaluates the performance of product categories
-- based on revenue, sales volume, and their contribution to
-- overall marketplace performance.
--
-- The analysis measures:
--   • Total sales generated by each category
--   • Average revenue per item
--   • Revenue generated per month
--   • Number of items sold
--   • Revenue contribution to total sales
--   • Item contribution to total sales volume
--   • Product category lifespan
--
-- Revenue and volume contribution are compared to identify
-- whether a category is primarily:
--   • High-Value — generates more revenue relative to its volume
--   • High-Volume — generates more volume relative to its revenue
--   • Balanced — revenue and volume contributions are similar
--
-- This report provides the foundation for deeper analysis of
-- which product categories drive marketplace revenue and volume,
-- before connecting product performance with customer segments.
-- ============================================================
IF OBJECT_ID('gold.vw_product_report', 'V') IS NOT NULL
    DROP VIEW gold.vw_product_report;
GO
CREATE VIEW gold.vw_product_report AS
SELECT 
	dp.product_category,
	SUM(order_item_payment) AS total_sales,
	AVG(order_item_payment) AS average_item_revenue,
	SUM(order_item_payment) / DATEDIFF(MONTH, MIN(fo.purchase_date), MAX(fo.purchase_date))	AS revenue_per_month,
	COUNT(*) AS items_sold,
	-- Percentage of total revenue generated by each category
    SUM(fo.order_item_payment) * 100.0
        / SUM(SUM(fo.order_item_payment)) OVER()
        AS revenue_contribution_pct,
	-- Percentage of total items sold represented by each category
    COUNT(*) * 100.0
        / SUM(COUNT(*)) OVER()
        AS item_contribution_pct,
	MIN(fo.purchase_date) AS first_purchase,
	MAX(fo.purchase_date) AS last_purchase,
	DATEDIFF(MONTH, MIN(fo.purchase_date), MAX(fo.purchase_date)) AS product_lifespan_months
FROM [gold].[fact_orders] AS fo
LEFT JOIN [gold].[dim_products] AS dp
ON dp.product_key = fo.product_key
GROUP BY dp.product_category
GO
-- ============================================================
-- Revenue vs. Volume Analysis
-- ============================================================
-- Compares each category's contribution to total revenue against
-- its contribution to total items sold.
--
-- This helps identify whether categories generate value through
-- higher revenue per item or through higher sales volume.
-- ============================================================

WITH cte_revenue_volume_gap AS (
SELECT
    product_category,
    total_sales,
    items_sold,
    revenue_contribution_pct,
    item_contribution_pct,
    revenue_contribution_pct - item_contribution_pct
        AS revenue_volume_gap
FROM gold.vw_product_report
)
SELECT
    product_category,
    total_sales,
    items_sold,
    revenue_volume_gap,
    CASE
        WHEN revenue_volume_gap > 0
            THEN 'High-Value Category'
        WHEN revenue_volume_gap < 0
            THEN 'High-Volume Category'
        ELSE 'Balanced Category'
    END AS category_type
FROM cte_revenue_volume_gap
