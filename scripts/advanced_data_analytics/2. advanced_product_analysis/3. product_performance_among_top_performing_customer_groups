-- ============================================================
-- Product Performance Among High-Value One-Time Customers
-- ============================================================

SELECT
    dp.product_category,
    COUNT(DISTINCT dc.customer_unique_id)
        AS high_value_one_time_customer_count,
    COUNT(*) AS items_sold,
    SUM(fo.order_item_payment)
        AS total_revenue,
    AVG(fo.order_item_payment)
        AS avg_item_revenue,

    -- Percentage of HVOT customers who purchased each category
    COUNT(DISTINCT dc.customer_unique_id) * 100.0
        / (
            SELECT COUNT(*)
            FROM gold.hvot_and_lec_customers
            WHERE customer_segment = 'High-Value One-Time Customer'
        ) AS customer_penetration_pct

FROM gold.fact_orders AS fo
LEFT JOIN gold.dim_customers AS dc
    ON dc.customer_key = fo.customer_key
LEFT JOIN gold.dim_products AS dp
    ON dp.product_key = fo.product_key
INNER JOIN gold.hvot_and_lec_customers AS halc
    ON halc.customer = dc.customer_unique_id
WHERE halc.customer_segment = 'High-Value One-Time Customer'
GROUP BY
    dp.product_category
ORDER BY
    total_revenue DESC

-- ============================================================
-- Product Performance Among Low-Engagement Customers
-- ============================================================

SELECT
    dp.product_category,
    COUNT(DISTINCT dc.customer_unique_id)
        AS low_engagement_customer_count,
    COUNT(*) AS items_sold,
    SUM(fo.order_item_payment)
        AS total_revenue,
    AVG(fo.order_item_payment)
        AS avg_item_revenue,
    -- Percentage of LEC customers who purchased each category
    COUNT(DISTINCT dc.customer_unique_id) * 100.0
        / (
            SELECT COUNT(*)
            FROM gold.hvot_and_lec_customers
            WHERE customer_segment = 'Low-Engagement Customer'
        ) AS customer_penetration_pct

FROM gold.fact_orders AS fo
LEFT JOIN gold.dim_customers AS dc
    ON dc.customer_key = fo.customer_key
LEFT JOIN gold.dim_products AS dp
    ON dp.product_key = fo.product_key
INNER JOIN gold.hvot_and_lec_customers AS halc
    ON halc.customer = dc.customer_unique_id
WHERE halc.customer_segment = 'Low-Engagement Customer'
GROUP BY
    dp.product_category
ORDER BY
    total_revenue DESC;
