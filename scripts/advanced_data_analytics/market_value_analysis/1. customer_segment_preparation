-- ============================================================
-- Customer Segment Preparation
-- ============================================================
-- CORE customer segments are materialized
-- into a physical table for faster downstream analysis.
--
-- Business Question:
-- Which product categories are purchased by Core High-Value Customer (Which two groups we have fount out to be CORE customers from the 
--                                                                       Segment Performance)
-- ============================================================

WITH cte_customer_segments AS
(
    SELECT
        customer,
        CASE
            WHEN total_orders = 1 THEN 'ONE-TIME'
            WHEN total_orders IN (2, 3) THEN 'OCCASIONAL'
            ELSE 'REGULAR'
        END AS purchase_behavior,
        CASE
            WHEN monetary_score = 5 THEN 'HIGH-VALUE'
            ELSE 'LOW-VALUE'
        END AS monetary_value
    FROM gold.vw_customer_report
)

-- Creates a table to list all these customers and which segment are they in
-- Decided to create a table instead of view because of slow query
SELECT
    customer,
    'Core High-Value Customer' AS customer_segment
INTO gold.core_customers -- Creates the table
FROM cte_customer_segments
WHERE purchase_behavior = 'REGULAR' AND monetary_value = 'HIGH-VALUE'

