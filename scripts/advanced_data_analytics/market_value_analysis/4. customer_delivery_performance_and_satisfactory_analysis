-- ============================================================
-- Delivery performance to CORE Customers
-- ============================================================
WITH customer_and_order_records AS (
SELECT
	customer_unique_id AS customer,
	purchase_date,
	shipping_limit_date,
	estimated_delivery_date,
	approval_date,
	carrier_delivery_date,
	customer_delivery_date
FROM [gold].[fact_orders] AS fo
LEFT JOIN [gold].[dim_customers] AS dc
ON dc.customer_key = fo.customer_key
), core_customer_records AS (
SELECT * FROM customer_and_order_records AS caor
WHERE caor.customer IN 
					(SELECT
						customer 
					FROM [gold].[core_customers])
), core_delivery_performance AS(
    SELECT 
        customer,
        DATEDIFF(DAY, purchase_date, customer_delivery_date) AS delivery_days,
		CASE 
			WHEN DATEDIFF(DAY, estimated_delivery_date, customer_delivery_date) < 0 
				THEN 'EARLY DELIVERY'
			WHEN DATEDIFF(DAY, estimated_delivery_date, customer_delivery_date) = 0
				THEN 'ON-TIME DELIVERY'
			ELSE 'LATE DELIVERY'
		END AS delivery_time_performance
    FROM core_customer_records
)

SELECT 
	AVG(delivery_days) AS avg_delivery_days,
    SUM(
        CASE
            WHEN delivery_time_performance = 'LATE DELIVERY'
                THEN 1
            ELSE 0
        END
    ) * 100.0 / COUNT(*) AS late_delivery_rate,
    STDEV(delivery_days) AS delivery_variability,
    MIN(delivery_days) AS minimum_delivery_days,
    MAX(delivery_days) AS maximum_delivery_days
FROM core_delivery_performance
