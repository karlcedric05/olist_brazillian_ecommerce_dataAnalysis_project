-- Defining the structure of bronze layer tables where we'll extract raw data from csv files
-- I made sure to keep the names of the columns, and use snake case as much as possible
-- I've also noticed that zip_code_prefix values have leading zeros and therefore made it a VARCHAR

CREATE TABLE bronze.products_dataset (
    product_id VARCHAR(250) NOT NULL,
    product_category_name VARCHAR(250) NULL,
    product_name_length INT NULL,
    product_description_lenght INT NULL,
    product_photos_qty INT NULL,
    product_weight_g INT NULL,
    product_length_cm INT NULL,
    product_height_cm INT NULL,
    product_width_cm INT NULL
);

CREATE TABLE bronze.orders_dataset (
    order_id VARCHAR(250) NOT NULL,
    customer_id VARCHAR(250) NULL,
    order_status VARCHAR(250) NULL,
    order_purchase_timestamp DATETIME2 NULL,
    order_approved_at DATETIME2 NULL,
    order_delivered_carrier_date DATETIME2 NULL,
    order_delivered_customer_date DATETIME2 NULL,
    order_estimated_delivery_date DATETIME2 NULL
);

CREATE TABLE bronze.order_reviews_dataset (
    review_id VARCHAR(250) NOT NULL,
    order_id VARCHAR(250) NULL,
    review_score INT NULL,
    review_comment_title VARCHAR(500) NULL,
    review_comment_message VARCHAR(MAX) NULL,
    review_creation_date DATETIME2 NULL,
    review_answer_timestamp DATETIME2 NULL
);

CREATE TABLE bronze.order_payments_dataset (
    order_id VARCHAR(250) NOT NULL,
    payment_sequential INT NULL,
    payment_type VARCHAR(250) NULL,
    payment_installments INT NULL,
    payment_value FLOAT NULL
);

CREATE TABLE bronze.order_items_dataset (
    order_id VARCHAR(250) NOT NULL,
    order_item_id INT NULL,
    product_id VARCHAR(250) NULL,
    seller_id VARCHAR(250) NULL,
    shipping_limit_date DATETIME2 NULL,
    price FLOAT NULL,
    freight_value FLOAT NULL
);

CREATE TABLE bronze.geolocation_dataset (
    zip_code_prefix VARCHAR(250) NOT NULL,
    geolocation_lat FLOAT NULL,
    geolocation_lng FLOAT NULL,
    geolocation_city VARCHAR(250) NULL,
    geolocation_state VARCHAR(250) NULL
);

CREATE TABLE bronze.customers_dataset (
    customer_id VARCHAR(250) NOT NULL,
    customer_unique_id VARCHAR(250) NULL,
    customer_zip_code_prefix VARCHAR(250) NULL,
    customer_city VARCHAR(250) NULL,
    customer_state VARCHAR(250) NULL
);

CREATE TABLE bronze.product_category_name_translation (
    product_category_name VARCHAR(250) NULL,
    product_category_name_english VARCHAR(250) NULL
);

CREATE TABLE bronze.sellers_dataset (
    seller_id VARCHAR(250) NOT NULL,
    seller_zip_code_prefix VARCHAR(250) NULL,
    seller_city VARCHAR(250) NULL,
    seller_state VARCHAR(250) NULL
);
