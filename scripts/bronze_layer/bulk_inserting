-- Import customer master data into the Bronze layer.

BULK INSERT [bronze].[customers_dataset]
FROM -- insert file path
WITH (
    FORMAT = 'CSV',
    FIRSTROW = 2,                 -- Skip the CSV header row.
    FIELDTERMINATOR = ',',
    FIELDQUOTE = '"',
    ROWTERMINATOR = '0x0A',
    CODEPAGE = '65001',           -- Import UTF-8 encoded files.
    TABLOCK                       -- Acquire a table lock to improve bulk load performance.
);

