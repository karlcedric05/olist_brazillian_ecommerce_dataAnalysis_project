-- Data quality checking (nulls/ duplicated values)
-- I will also put the query at the very end part of each section to show the changes that I made to transform the data before storing into the silver layer
-- Documentations will also be included to reason each decision making 

-- ============================================================================================================================== 
-- ============================================================================================================================== 

-- Customers' dataset

-- Checking for NULL values
SELECT * FROM [bronze].[customers_dataset]
WHERE customer_unique_id IS NULL OR customer_zip_code_prefix IS NULL OR customer_city IS NULL OR customer_state IS NULL

-- Checking for duplicate customer records
SELECT COUNT(customer_id) FROM [bronze].[customers_dataset]
GROUP BY customer_id
HAVING COUNT(DISTINCT customer_id) != 1

-- Checking the distinct values of customer cities and states
-- to identify potential inconsistencies in naming conventions or data entry.

SELECT DISTINCT customer_city FROM [bronze].[customers_dataset]
ORDER BY customer_city

SELECT DISTINCT customer_state FROM [bronze].[customers_dataset]
ORDER BY customer_state

-- The dataset appears to be clean, with no missing values in the inspected columns,
-- no duplicate customer records, and no obvious inconsistencies in city or state values.
-- Based on these findings, the dataset is ready to be promoted to the Silver layer.

SELECT * FROM [bronze].[customers_dataset]
