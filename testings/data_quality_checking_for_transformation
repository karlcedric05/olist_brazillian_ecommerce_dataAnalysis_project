-- Order Payments dataset

-- Checking for NULL values
-- No NULL values were found in any column, indicating that the dataset is complete.

-- Checking for invalid payment amounts (negative values) and invalid installment counts.
SELECT * FROM [bronze].[order_payments_dataset]
WHERE payment_installments < 0 OR payment_value < 0
 
-- Identifying the distinct payment methods used across all orders.
SELECT DISTINCT(payment_type) FROM [bronze].[order_payments_dataset]
-- The dataset contains the following payment methods:
-- credit_card, debit_card, voucher, boleto, and not_defined.

-- Examining the relationship between each order and its payment sequence.
SELECT * FROM [bronze].[order_payments_dataset]
ORDER BY order_id, payment_sequential
-- The payment_sequential column represents the sequence of payment transactions
-- associated with the same order (e.g., 1 → 2 → ... → n).
-- This indicates that a single order may be paid using multiple payment transactions
-- or a combination of different payment methods.

-- 'not_defined' will be standardized to 'n/a' to maintain consistent representation
-- of unknown or unavailable values across all datasets in the data warehouse.
-- The following query prepares the dataset for the Silver layer.

SELECT 
	order_id,
	payment_sequential,
	CASE
		WHEN payment_type = 'not_defined' THEN 'n/a'
		ELSE payment_type
	END AS payment_type,
	payment_installments,
	payment_value
FROM [bronze].[order_payments_dataset]
